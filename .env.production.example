# Deployment template for an independently hosted hackathon demonstration.
# Store actual values in the hosting environment, never in source control.
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://aegis.example.net
NEXT_PUBLIC_SPACETIMEDB_HOST=https://database.example.net
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=aegis-demo
SPACETIMEDB_SERVER_TOKEN=replace-with-private-spacetimedb-service-token
AEGIS_GATEWAY_IDENTITY=replace-with-service-identity-hex
AEGIS_TEST_MODE=false
SMS_DELIVERY_MODE=demo
# No corporate SSO, VPN, email, directory, or database configuration is required.
# PHOTON_API_KEY and PHOTON_SENDER remain unused until a provider contract is verified.

# Required server-only private storage, outside frontend/public. Back up with database state.
EVIDENCE_STORAGE_DIR=/absolute/private/path/aegis-evidence
# Publish this module setting as false outside development/test.
AEGIS_DEVELOPMENT_MODE=false

# Paging always uses a five-minute server deadline outside development/test.
# No SMS/phone transport or browser-driven escalation is configured.
