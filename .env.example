# Optional root .env.local. Public values must match frontend/.env.local.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SPACETIMEDB_HOST=http://127.0.0.1:3001
NEXT_PUBLIC_SPACETIMEDB_DB_NAME=aegis-local
SPACETIMEDB_DATA_DIR=.spacetime/data
# SPACETIME_CLI=/absolute/path/to/spacetime

# Server-only. Local npm run dev provisions these in ignored .spacetime/data/gateway.json.
# Supply both through your host's secret/configuration store for deployment.
# SPACETIMEDB_SERVER_TOKEN=
# AEGIS_GATEWAY_IDENTITY=
# Addition A: separate SERVER/MODULE worker identity, provisioned locally in ignored
# <SPACETIMEDB_DATA_DIR>/investigation-worker.json. Supply both for deployment.
# SPACETIMEDB_WORKER_TOKEN=
# AEGIS_WORKER_IDENTITY=

# Optional private bootstrap password; otherwise six random passwords are generated locally.
# Applies only on first database bootstrap. Never commit a real value.
# AEGIS_DEMO_PASSWORD=
SMS_DELIVERY_MODE=demo

# Reserved, unused: no verified Photon SMS contract is integrated.
PHOTON_API_KEY=
PHOTON_SENDER=
# Sessions expire after 8 hours. Invitations expire after 1 hour (backend-enforced constants).
# Test fixtures are disabled by default. Do not set AEGIS_TEST_MODE=true outside isolated tests.

# Phase 2 server-only private originals; inherited by Next.js from the root runner.
# Local default: <SPACETIMEDB_DATA_DIR>/evidence (resolved to an absolute path).
# EVIDENCE_STORAGE_DIR=/absolute/private/path/aegis-evidence
# AEGIS_DEVELOPMENT_MODE is a module publication setting: false outside local/test.

# Phase 4: optional SERVER/MODULE development policy, in seconds (5..300; default 300).
# The module forces 300 when development/test mode is false. Never NEXT_PUBLIC_*.
# AEGIS_PAGE_ACK_SECONDS=300

# Addition B: SERVER-ONLY model configuration (never NEXT_PUBLIC_*).
# Default endpoint/model: OpenAI Chat Completions, gpt-6-luna.
# AEGIS_MODEL_API_KEY=
# Optional override for one independently configured compatible endpoint/model:
# AEGIS_MODEL_BASE_URL=https://api.openai.com/v1
# AEGIS_MODEL_ID=gpt-6-luna
