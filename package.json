{
  "name": "aegis",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend/spacetimedb"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "scripts": {
    "postinstall": "node scripts/setup-env.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "node scripts/frontend.mjs",
    "dev:db": "node scripts/db.mjs start",
    "db:build": "node scripts/db.mjs build",
    "db:publish": "node scripts/db.mjs publish",
    "db:generate": "node scripts/db.mjs generate",
    "env:check": "node scripts/check-env.mjs",
    "build": "npm run db:build && npm run build --workspace @aegis/frontend",
    "lint": "npm run lint --workspace @aegis/frontend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @aegis/frontend",
    "test:e2e": "npm run test:e2e --workspace @aegis/frontend",
    "test:e2e:extended": "npm run test:e2e:extended --workspace @aegis/frontend",
    "test:e2e:restart": "npm run test:e2e:restart --workspace @aegis/frontend",
    "db:seed": "node scripts/seed.mjs",
    "demo:accounts": "node scripts/demo-accounts.mjs",
    "demo:reset": "node scripts/reset-demo.mjs",
    "demo:recovery": "node scripts/recovery-demo.mjs"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
